#!/usr/bin/env zsh
#
# missionevents - profile-driven mission_events runner with orbit dedup
# Version 2.0.0 (2026-09-03), formerly me_dedup
# Author: jama2218
#
# Runs mission_events on a profile's remote host via ssh, sourcing the mission
# environment first (equivalent of typing the mission name after login).
# With DEDUP=y, orbits having both AscendingNode and StationContact events
# show only the StationContact.
#
# Usage:
#   missionevents                    interactive profile menu (build new from there)
#   missionevents --build (-b)       step-by-step profile creator
#   missionevents --list  (-l)       list saved profiles
#   missionevents <profile> [args]   run via a profile (e.g. missionevents ixpe -n 0:1)
#   missionevents [args]             run via the default profile (ixpe)
#   missionevents --help  (-h)       quick reference
#
# Profiles: ~/.missionevents/profiles/<name>  (plain KEY=VALUE, hand-editable)
# Requires: zsh, awk, ssh. No local mission software needed.
#
typeset -g MISSIONEVENTS_DIR="${MISSIONEVENTS_DIR:-$HOME/.missionevents}"
typeset -g MISSIONEVENTS_PROFILES="$MISSIONEVENTS_DIR/profiles"
typeset -g MISSIONEVENTS_DEFAULT="ixpe"

# shared dedup filter: header preserved, chronological order preserved, other event
# types pass through untouched, AscendingNode dropped when its orbit has a StationContact
_missionevents_filter() {
  awk '
    /^20[0-9][0-9]\// { data=1 }
    !data            { print; next }
    /StationContact/ { contacts[$7]=1; rows[NR]=$0; next }
    /AscendingNode/  { orbit[NR]=$7; rows[NR]=$0; next }
                     { rows[NR]=$0 }
    END {
      for (i in orbit) if (orbit[i] in contacts) delete rows[i]
      for (i=1; i<=NR; i++) if (i in rows) print rows[i]
    }'
}

# first run: migrate me_dedup v1 profiles, then seed the known-good ixpe profile
_missionevents_seed() {
  if [[ ! -d $MISSIONEVENTS_DIR && -d $HOME/.me_dedup ]]; then
    mv "$HOME/.me_dedup" "$MISSIONEVENTS_DIR"
  fi
  [[ -d $MISSIONEVENTS_PROFILES ]] || mkdir -p "$MISSIONEVENTS_PROFILES"
  [[ -f $MISSIONEVENTS_PROFILES/ixpe ]] && return
  cat > "$MISSIONEVENTS_PROFILES/ixpe" <<'EOF'
# missionevents profile: ixpe
HOST="green-ixpe-gp1"
REMOTE_USER=""
SOURCE_CMD="source /lasp/ixpe/setup.bourne"
DEDUP="y"
TYPE_NAMES="AscendingNode StationContact"
DEFAULT_N="0:1"
SSH_OPTS=""
NOTES="IXPE (Imaging X-ray Polarimetry Explorer)"
EOF
}

# load profile $1 into the caller's local vars (zsh dynamic scoping)
_missionevents_load() {
  local f="$MISSIONEVENTS_PROFILES/$1"
  if [[ ! -f $f ]]; then
    print -u2 "missionevents: no profile '$1' (looked in $MISSIONEVENTS_PROFILES)"
    print -u2 "Run 'missionevents --list' to see profiles, 'missionevents --build' to create one."
    return 1
  fi
  source "$f"
}

_missionevents_list() {
  local -a names
  names=("$MISSIONEVENTS_PROFILES"/*(N:t))
  (( $#names )) || { print "No profiles yet. Run 'missionevents --build'."; return; }
  local n HOST REMOTE_USER NOTES
  for n in $names; do
    HOST= REMOTE_USER= NOTES=
    source "$MISSIONEVENTS_PROFILES/$n" 2>/dev/null
    printf "%-10s %s%s %s\n" "$n" "${REMOTE_USER:+$REMOTE_USER@}" "$HOST" "${NOTES:+- $NOTES}"
  done
}

# interactive wizard: explains each setting, Enter accepts [default] or skips optional
_missionevents_build() {
  local name host ruser source_cmd dedup type_names default_n ssh_opts notes yn
  print "=== missionevents profile builder ==="
  print "Each setting is explained first. Enter accepts the [default] or skips optional ones.\n"

  print "PROFILE NAME: short label used to select this profile (e.g. ixpe, mms, tsis2)."
  print "  Use the mission name in lowercase; it also seeds the setup-path guess below."
  read "name?Profile name: "
  name=${${name//[[:space:]]/}:l}
  [[ -n $name ]] || { print "Aborted: a name is required."; return 1; }
  if [[ -f $MISSIONEVENTS_PROFILES/$name ]]; then
    read "yn?Profile '$name' already exists. Overwrite? [y/N]: "
    [[ ${yn:l} == y* ]] || { print "Aborted."; return 1; }
  fi

  print "\nREMOTE HOST: the machine where mission_events runs for this mission."
  print "  Accepts a hostname (green-mms-gp1), FQDN, or a Host alias from ~/.ssh/config."
  read "host?Remote host: "
  [[ -n $host ]] || { print "Aborted: a host is required."; return 1; }

  print "\nREMOTE USER: your username on $host."
  print "  Only needed if it differs from this machine's username ($USER)."
  print "  Without ssh keys, ssh will prompt for a password on each run -- that is normal."
  read "ruser?Remote user [skip = $USER]: "

  print "\nMISSION SOURCE: command that loads the mission environment on $host."
  print "  Interactive equivalent: typing the mission name after login (e.g. 'ixpe')."
  print "  Non-interactively it is usually: source /lasp/<mission>/setup.bourne"
  local guess="source /lasp/$name/setup.bourne"
  read "source_cmd?Source command [$guess]: "
  : ${source_cmd:=$guess}

  print "\nDEDUP: when an orbit has BOTH AscendingNode and StationContact events, show only"
  print "  the StationContact (the classic dedup behavior). Answer n to keep all rows."
  read "dedup?Dedup AscendingNode duplicates? [Y/n]: "
  [[ ${${dedup:l}:-y} == n* ]] && dedup=n || dedup=y

  print "\nDEFAULT EVENT TYPES: used only when you don't pass --type-names yourself."
  print "  Example: AscendingNode StationContact. Skip to let mission_events show all types."
  read "type_names?Default event types [skip]: "

  print "\nDEFAULT TIME RANGE: used only when you don't pass -n or explicit dates."
  print "  Example: 0:1 (today to tomorrow). Skip to always specify per run."
  read "default_n?Default time range [skip]: "

  print "\nEXTRA SSH OPTIONS: rarely needed (e.g. '-o ProxyJump=gw1,gw2' for hosts behind"
  print "  gateways). A Host entry in ~/.ssh/config is usually the better place. Skip normally."
  read "ssh_opts?Extra ssh options [skip]: "

  print "\nDESCRIPTION: one line shown next to the profile in 'missionevents --list'."
  read "notes?Description [skip]: "

  {
    print -r -- "# missionevents profile: $name"
    print -r -- "HOST=\"${host//\"/\\\"}\""
    print -r -- "REMOTE_USER=\"${ruser//\"/\\\"}\""
    print -r -- "SOURCE_CMD=\"${source_cmd//\"/\\\"}\""
    print -r -- "DEDUP=\"$dedup\""
    print -r -- "TYPE_NAMES=\"${type_names//\"/\\\"}\""
    print -r -- "DEFAULT_N=\"${default_n//\"/\\\"}\""
    print -r -- "SSH_OPTS=\"${ssh_opts//\"/\\\"}\""
    print -r -- "NOTES=\"${notes//\"/\\\"}\""
  } > "$MISSIONEVENTS_PROFILES/$name" || return 1
  print "\nSaved: $MISSIONEVENTS_PROFILES/$name"

  read "yn?Test it now? ssh to $host and list event types (password prompt if no ssh keys). [Y/n]: "
  [[ ${${yn:l}:-y} == n* ]] && return 0
  local target="$host"; [[ -n $ruser ]] && target="$ruser@$host"
  if ssh ${=ssh_opts} "$target" "$source_cmd >/dev/null 2>&1 && mission_events --print-event-types 2>&1 | head -5"; then
    print "Profile works. Try: missionevents $name"
  else
    print -u2 "Test failed -- check host, username, ssh access, and the source command."
    print -u2 "The profile was saved anyway; edit $MISSIONEVENTS_PROFILES/$name and retest."
  fi
}

# interactive profile picker (no profile name memorizing required)
_missionevents_menu() {
  local -a names
  names=("$MISSIONEVENTS_PROFILES"/*(N:t))
  print "Saved profiles:"
  local i sel pargs
  local HOST REMOTE_USER NOTES
  for i in {1..$#names}; do
    HOST= REMOTE_USER= NOTES=
    source "$MISSIONEVENTS_PROFILES/$names[$i]" 2>/dev/null
    printf "  %d) %-10s %s%s %s\n" "$i" "$names[$i]" "${REMOTE_USER:+$REMOTE_USER@}" "$HOST" "${NOTES:+- $NOTES}"
  done
  print "  b) Build a new profile"
  read "sel?Select profile [1]: "
  sel=${sel:-1}
  if [[ ${sel:l} == b* ]]; then _missionevents_build; return; fi
  if [[ ! $sel == <-> || $sel -lt 1 || $sel -gt $#names ]]; then
    print -u2 "missionevents: invalid selection"; return 1
  fi
  read "pargs?mission_events args for '$names[$sel]' [Enter = profile defaults]: "
  if [[ -n $pargs ]]; then
    missionevents "$names[$sel]" ${(z)pargs}
  else
    missionevents "$names[$sel]"
  fi
}

_missionevents_help() {
  cat <<'EOF'
missionevents - mission_events without duplicate orbits, across missions
           (orbits with a StationContact hide their AscendingNode)

Runs mission_events on the profile's remote host via ssh (mission env is
sourced automatically; password prompt if you have no ssh keys -- normal).
Events include both predicted and historical (actual).

PROFILES (multi-mission: IXPE, MMS, IMAP, TSIS, TSIS2, CPRS, ...):
    missionevents                        interactive menu: pick a profile or build one
    missionevents --build (-b)           step-by-step profile creator (explains each setting)
    missionevents --list (-l)            list saved profiles
    missionevents <profile> [args]       run via that profile (e.g. missionevents ixpe -n 0:1)
    Profiles: ~/.missionevents/profiles/ (plain KEY=VALUE text, hand-editable)

USAGE (args not matching a profile go to the default profile, ixpe):
    missionevents -n <range> --type-names AscendingNode StationContact
    missionevents "2026/001" "2026/014" [--contacts]   # explicit date range
    (-n 1 is shorthand for -n 0:1, today to tomorrow)

COMMON TIME RANGES:
    -n -1:0    Yesterday to today       -n 0:1     Today to tomorrow
    -n -7:0    Last 7 days              -n 0:7     Next 7 days
    -n -30:0   Last 30 days             -n 0:30    Next 30 days
    -n -2:3    2 days ago to +3 days    -n -7:7    Last week to next week

OTHER USEFUL FLAGS (passed through to mission_events):
    --contacts                          contact schedule in AOS/LOS format
    --exclude-type-names X [Y ...]      show everything except these types
    --local-timezone "Asia/Dubai"       local-time column in that timezone
    --print-event-types                 list all event types for the mission
    --csv/--ics/--xml [file]            structured output (no dedup applied;
                                        files are written on the remote host)

EXAMPLES (shown for the default ixpe profile):
    missionevents -n 0:3 --type-names AscendingNode StationContact     # next 3 days (planning)
    missionevents -n 0:1 --type-names AscendingNode StationContact     # today only
    missionevents -n -3:4 --type-names AscendingNode StationContact    # this week, past + future
    missionevents -n 0:7 --type-names AscendingNode StationContact | grep -c IXPE   # count unique orbits
    missionevents -n -7:0 --type-names AscendingNode StationContact > weekly.txt    # save weekly report
    missionevents -n 0:7 --type-names AscendingNode StationContact | grep Station   # contacts only
    missionevents -n 0:1 --contacts                                    # contact schedule
    missionevents -n 0:7 --type-names Slew                             # upcoming slews
    missionevents -n 0:1 --exclude-type-names AscendingNode Penumbra   # hide noisy types
    missionevents imap -n 0:7 --contacts                               # another mission

NOTE: -h/--help show this card. For a mission's full mission_events flag list:
      ssh <host> 'source <setup> && mission_events -h'
      (host and setup for each profile are in ~/.missionevents/profiles/<name>)
EOF
}

missionevents() {
  _missionevents_seed
  case "$1" in
    --help|-h)  _missionevents_help;  return ;;
    --build|-b) _missionevents_build; return ;;
    --list|-l)  _missionevents_list;  return ;;
    "")         _missionevents_menu;  return ;;
  esac

  local profile="$MISSIONEVENTS_DEFAULT"
  if [[ -f $MISSIONEVENTS_PROFILES/$1 ]]; then profile="$1"; shift; fi

  local HOST REMOTE_USER SOURCE_CMD DEDUP TYPE_NAMES DEFAULT_N SSH_OPTS NOTES
  HOST= REMOTE_USER= SOURCE_CMD= DEDUP=y TYPE_NAMES= DEFAULT_N= SSH_OPTS= NOTES=
  _missionevents_load "$profile" || return 1

  # no args at all -> apply the profile's defaults (if any)
  if (( $# == 0 )); then
    [[ -n $DEFAULT_N ]]  && set -- -n "$DEFAULT_N"
    [[ -n $TYPE_NAMES ]] && set -- "$@" --type-names ${=TYPE_NAMES}
  fi

  local target="$HOST"; [[ -n $REMOTE_USER ]] && target="$REMOTE_USER@$HOST"
  local args
  printf -v args ' %q' "$@"
  local cmd="$SOURCE_CMD >/dev/null 2>&1 && mission_events$args"

  # structured output modes bypass the dedup filter entirely
  if [[ " $* " == *" --csv "* || " $* " == *" --ics "* || " $* " == *" --xml "* ]]; then
    ssh ${=SSH_OPTS} "$target" "$cmd"
    return
  fi
  if [[ $DEDUP == y ]]; then
    ssh ${=SSH_OPTS} "$target" "$cmd" | _missionevents_filter
  else
    ssh ${=SSH_OPTS} "$target" "$cmd"
  fi
}

# ---- dispatch ----
missionevents "$@"
